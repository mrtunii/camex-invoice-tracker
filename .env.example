# Copy to .env (repo root). The API, Prisma CLI, tests and docker compose all read this file.

# --- App ---
# development | test | production (production turns on Secure cookies and serves the built SPA)
NODE_ENV=development
# Port the API listens on (the Vite dev server proxies /api here)
PORT=3000
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Express "trust proxy" hop count; set to 1 behind one reverse proxy so client IPs (rate limits) are real
TRUST_PROXY=0
# Optional: absolute path to the built SPA served in production (default: apps/web/dist)
# WEB_DIST_DIR=/app/apps/web/dist

# --- Database ---
# Postgres connection string used by the API and Prisma migrations
DATABASE_URL=postgresql://camex:camex@localhost:5432/camex
# Separate database used by `pnpm test` (created and migrated automatically; wiped between tests)
TEST_DATABASE_URL=postgresql://camex:camex@localhost:5432/camex_test

# --- Object storage (S3-compatible; MinIO locally) ---
# S3 endpoint URL; leave empty to use AWS S3 for the region
S3_ENDPOINT=http://localhost:9000
# S3 region (MinIO accepts any value)
S3_REGION=us-east-1
# Private bucket for emails and PDFs (docker compose creates it)
S3_BUCKET=camex-invoices
# Access key; locally this is also the MinIO root user
S3_ACCESS_KEY_ID=camex-dev
# Secret key; locally this is also the MinIO root password (min 8 chars)
S3_SECRET_ACCESS_KEY=camex-dev-secret
# Path-style URLs (true for MinIO, false for AWS S3)
S3_FORCE_PATH_STYLE=true

# --- docker compose (local dev only) ---
# Host port for Postgres (keep in sync with DATABASE_URL / TEST_DATABASE_URL)
POSTGRES_PORT=5432
# Host port for the MinIO S3 API (keep in sync with S3_ENDPOINT)
MINIO_PORT=9000
# Host port for the MinIO web console (http://localhost:9001)
MINIO_CONSOLE_PORT=9001
