# Copy to .env (repo root). The API, Prisma CLI, tests and docker compose all read this file.
# Values here are local-development placeholders only; production sets its own.

# --- App ---
# development | test | production (production turns on Secure cookies and serves the built SPA)
NODE_ENV=development
# Port the API listens on (the Vite dev server on :5180 proxies /api here)
PORT=3180
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Express "trust proxy" hop count; set to 1 behind one reverse proxy so client IPs (rate limits) are real
TRUST_PROXY=0
# Optional: absolute path to the built SPA served in production (default: apps/web/dist)
# WEB_DIST_DIR=/app/apps/web/dist

# --- First admin (production has no shell: this is the primary way to create the first user) ---
# Created on boot only when the users table is empty; must change the password on first login.
# Set both or neither. Remove them once the admin exists (the app warns while they are set).
BOOTSTRAP_ADMIN_EMAIL=
# At least 12 characters
BOOTSTRAP_ADMIN_PASSWORD=
# Optional display name (default "Admin")
BOOTSTRAP_ADMIN_NAME=

# --- Database ---
# Postgres connection string used by the API, pg-boss and Prisma migrations
DATABASE_URL=postgresql://camex:camex@localhost:55432/camex
# Separate database used by `pnpm test` (created and migrated automatically; wiped between tests)
TEST_DATABASE_URL=postgresql://camex:camex@localhost:55432/camex_test

# --- Object storage (S3-compatible; MinIO locally) ---
# S3 endpoint URL; leave empty to use AWS S3 for the region
S3_ENDPOINT=http://localhost:59000
# S3 region (MinIO accepts any value)
S3_REGION=us-east-1
# Private bucket for invoice PDFs (docker compose creates it)
S3_BUCKET=camex-invoices
# Separate bucket used by `pnpm test` (created automatically; emptied at the start of each run)
TEST_S3_BUCKET=camex-invoices-test
# Access key; locally this is also the MinIO root user
S3_ACCESS_KEY_ID=camex-dev
# Secret key; locally this is also the MinIO root password (min 8 chars)
S3_SECRET_ACCESS_KEY=camex-dev-secret
# Path-style URLs (true for MinIO, false for AWS S3 virtual-hosted style)
S3_FORCE_PATH_STYLE=true

# --- Inbound email (Mailgun) and uploads ---
# Mailgun "HTTP webhook signing key" (Mailgun → Settings → Webhooks). Local placeholder only:
# `pnpm simulate:mailgun` signs with whatever is set here.
MAILGUN_WEBHOOK_SIGNING_KEY=local-dev-only-signing-key
# Largest webhook request, in MB. Bigger requests (and any other webhook limit violation) get 406,
# which tells Mailgun not to retry; a Content-Length over this is rejected without reading the body
INBOUND_MAX_REQUEST_MB=30
# Largest accepted attachment / uploaded file, in MB
INBOUND_MAX_FILE_MB=25
# Most files accepted in one email or one upload
INBOUND_MAX_FILES=20

# --- Extraction jobs (pg-boss, runs in the API process) ---
# Extractor implementation: anthropic (real extraction) | stub (no API call: an empty result after ~500 ms)
EXTRACTOR_PROVIDER=stub
# Anthropic API key; required when EXTRACTOR_PROVIDER=anthropic and for `pnpm eval:extraction`. Never commit it.
ANTHROPIC_API_KEY=
# Model id for extraction
EXTRACTION_MODEL=claude-sonnet-5-5
# Timeout per API call in seconds (the SDK retries once, so twice this must stay under the 300 s job expiry)
EXTRACTION_TIMEOUT_SECONDS=90
# Base delay before retrying a failed extraction (exponential backoff, 3 attempts in total)
EXTRACTION_RETRY_DELAY_SECONDS=30
# Run job workers (extraction + recovery sweep) in this process
WORKERS_ENABLED=true

# --- docker compose (local dev only) ---
# Host port for Postgres (keep in sync with DATABASE_URL / TEST_DATABASE_URL)
POSTGRES_PORT=55432
# Host port for the MinIO S3 API (keep in sync with S3_ENDPOINT)
MINIO_PORT=59000
# Host port for the MinIO web console (http://localhost:59001)
MINIO_CONSOLE_PORT=59001
