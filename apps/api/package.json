{
  "name": "@camex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "create-admin": "tsx src/cli/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@camex/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/serve-static": "^12.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "nestjs-pino": "^5.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
